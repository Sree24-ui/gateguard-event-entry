{
  "name": "gateguard",
  "private": true,
  "version": "1.0.0",
  "description": "GateGuard — QR ticketing, gate scanning and live attendance for college events",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "npm run test -w server && npm run test -w web",
    "test:server": "npm run test -w server",
    "test:web": "npm run test -w web",
    "lint": "npm run lint -w web",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "mongodb-memory-server@10.4.3": true
  }
}
