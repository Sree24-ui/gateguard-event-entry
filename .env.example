# ---------------------------------------------------------------------------
# GateGuard environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# MongoDB connection string.
#   local:  mongodb://127.0.0.1:27017/gateguard
#   Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gateguard?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gateguard

# Signs session cookies. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# Signs QR ticket payloads. Generate with: openssl rand -base64 48
# Rotating this invalidates every QR already in circulation.
TICKET_SECRET=replace-me-with-a-different-long-random-string

# How long a signed-in session lasts, in days.
SESSION_DAYS=7

# Local API port. Ignored on Vercel.
PORT=4000

# Extra browser origins allowed to call the API with credentials. Leave empty
# when the frontend and API share one origin (the default deployment).
# Example: CORS_ORIGINS=https://gateguard.example.com,http://localhost:5173
CORS_ORIGINS=

# Set to 1 ONLY in automated tests, where hundreds of requests run through one
# process. Never set it in a deployed environment.
RATE_LIMIT_DISABLED=

# --- Attendee sign-in ------------------------------------------------------
# Echoes the one-time sign-in code in the API response. Development only:
# there is no email provider wired up yet, so without this the code is only
# visible in the server log. NEVER set this in production.
OTP_DEV_ECHO=

# --- Passkeys (WebAuthn) ---------------------------------------------------
# The site's domain, exactly. Taken from configuration rather than the Host
# header, which a caller controls.
#   local:      localhost          / http://localhost:5173
#   production: your.domain        / https://your.domain
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Password for the accounts created by `npm run seed`. Demo data only.
DEMO_PASSWORD=gateguard-demo
